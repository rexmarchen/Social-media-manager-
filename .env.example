# -----------------------------------------------------------
# Social Manager Agent
# -----------------------------------------------------------
# Comma-separated target platforms: linkedin,instagram,reddit
SOCIAL_PLATFORMS=linkedin

# Keep this true while testing. Set false only when you really want scheduled
# runs to publish without asking for approval first.
SOCIAL_AGENT_REQUIRE_APPROVAL=true

# Optional: let Gemini generate a local image when the model says one helps.
SOCIAL_AGENT_GENERATE_IMAGES=false

# RAG configuration. Only folders/files listed here or passed via --sources
# should be ingested. Do not point this at your whole computer unless you have
# reviewed the privacy implications.
RAG_COLLECTION_NAME=social_agent_knowledge
RAG_CHUNK_SIZE=900
RAG_CHUNK_OVERLAP=120

# -----------------------------------------------------------
# LinkedIn Credentials
# -----------------------------------------------------------
# LinkedIn OAuth 2.0 Access Token with 'w_member_social' scope
LINKEDIN_ACCESS_TOKEN=your_linkedin_access_token_here
LINKEDIN_VERSION=202604

# (Optional for Python agent, required for Node.js agent)
# Person URN (e.g. urn:li:person:AbC123xyz) - retrieved via GET https://api.linkedin.com/v2/userinfo
LINKEDIN_PERSON_URN=urn:li:person:YOUR_PERSON_SUB_ID

# -----------------------------------------------------------
# Instagram Credentials (Meta Graph API)
# -----------------------------------------------------------
# Requires an Instagram professional account connected to a Facebook app/page.
# Instagram feed publishing needs a publicly reachable image URL.
INSTAGRAM_ACCESS_TOKEN=your_instagram_graph_access_token_here
INSTAGRAM_USER_ID=your_instagram_business_or_creator_user_id_here
INSTAGRAM_GRAPH_VERSION=v24.0
INSTAGRAM_DEFAULT_IMAGE_URL=https://example.com/default-image.jpg

# -----------------------------------------------------------
# Reddit Credentials
# -----------------------------------------------------------
# Create a script app at https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=your_reddit_client_id_here
REDDIT_CLIENT_SECRET=your_reddit_client_secret_here
REDDIT_USERNAME=your_reddit_username_here
REDDIT_PASSWORD=your_reddit_password_here
REDDIT_USER_AGENT=social-agent/1.0 by your_reddit_username
REDDIT_SUBREDDIT=test

# -----------------------------------------------------------
# AI Providers
# -----------------------------------------------------------
# Anthropic API Key (from https://console.anthropic.com/)
ANTHROPIC_API_KEY=sk-ant-your_anthropic_key_here
POST_TOPIC="AI trends in software engineering"
POST_TIME="09:00"
# ANTHROPIC_MODEL=claude-3-7-sonnet-latest

# -----------------------------------------------------------
# Node.js Agent (agent.js with Gemini RAG)
# -----------------------------------------------------------
# Gemini API Key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
# LLM_PROVIDER=gemini
# GEMINI_TEXT_MODEL=gemini-2.0-flash
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# GEMINI_IMAGE_MODEL=imagen-3.0-generate-002
# OPENAI_API_KEY=sk-your_openai_key_here
# OPENAI_MODEL=gpt-4o-mini

# -----------------------------------------------------------
# MongoDB Atlas & GitHub Activity Tracker
# -----------------------------------------------------------
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abyixcg.mongodb.net/linkedin_agent?retryWrites=true&w=majority&appName=Cluster0
# GITHUB_USERNAME=your_github_username
