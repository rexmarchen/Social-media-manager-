{
  "name": "linkedin-rag-agent",
  "version": "2.0.0",
  "description": "LinkedIn posting agent with local RAG over your own documents, controllable via Telegram",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "ingest": "node ingest.js",
    "watch": "node watch-ingest.js",
    "dry-run": "node test-dry-run.js",
    "brain": "node super-brain.js",
    "brain:train": "node super-brain.js --train",
    "brain:force": "node super-brain.js --force",
    "jobs": "node job-monitor.js",
    "jobs:dry": "node job-monitor.js --dry-run",
    "jobs:test-email": "node job-monitor.js --test-email",
    "bot:start": "pm2 start server.js --name linkedin-agent",
    "bot:status": "pm2 status",
    "bot:logs": "pm2 logs linkedin-agent --lines 50",
    "bot:stop": "pm2 stop linkedin-agent",
    "bot:restart": "pm2 restart linkedin-agent"
  },
  "keywords": [
    "linkedin",
    "rag",
    "gemini",
    "automation",
    "agent"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "chokidar": "^3.6.0",
    "dotenv": "^16.4.7",
    "express": "^4.19.2",
    "mammoth": "^1.8.0",
    "mongodb": "^7.6.0",
    "node-cron": "^3.0.3",
    "nodemailer": "^10.0.10",
    "pdf-parse": "^1.1.1",
    "pm2": "^7.0.4",
    "vectra": "^0.9.0"
  }
}
